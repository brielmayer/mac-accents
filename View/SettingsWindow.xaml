<Window x:Class="MacAccents.View.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MacAccents Settings"
        Icon="pack://application:,,,/Assets/app.ico"
        SizeToContent="Height"
        Width="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F2F2F7"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Grouped-section card -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="BorderBrush" Value="#E5E5EA"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#8A8A8E"/>
            <Setter Property="Margin" Value="4,0,0,6"/>
        </Style>

        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#1D1D1F"/>
        </Style>

        <Style x:Key="RowSubtitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="#8A8A8E"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <!-- Primary (accent) button -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#0A84FF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                CornerRadius="7" Padding="16,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#0071E3"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bg" Property="Background" Value="#B7B7BC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary (outline) button -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#1D1D1F"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                BorderBrush="#D0D0D5" BorderThickness="1"
                                CornerRadius="7" Padding="16,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#F0F0F2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#B7B7BC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toggle switch (CheckBox retemplated) -->
        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="track" Width="42" Height="24" CornerRadius="12"
                                Background="#D6D6DC">
                            <Border x:Name="thumb" Width="20" Height="20" CornerRadius="10"
                                    Background="White" HorizontalAlignment="Left" Margin="2,0,0,0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="3" ShadowDepth="0.5" Opacity="0.35"/>
                                </Border.Effect>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="#34C759"/>
                                <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="thumb" Property="Margin" Value="0,0,2,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="22,20,22,20">

        <!-- Header -->
        <StackPanel Orientation="Horizontal" Margin="2,0,0,18">
            <Image Source="pack://application:,,,/Assets/app.ico" Width="46" Height="46"/>
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="MacAccents" FontSize="20" FontWeight="SemiBold" Foreground="#1D1D1F"/>
                <TextBlock Text="{Binding VersionText}" FontSize="12" Foreground="#8A8A8E"/>
            </StackPanel>
        </StackPanel>

        <!-- GENERAL -->
        <TextBlock Text="GENERAL" Style="{StaticResource SectionHeader}"/>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Hold delay" Style="{StaticResource RowTitle}"/>
                <TextBlock Text="How long to hold a key before the accent popup appears."
                           Style="{StaticResource RowSubtitle}"/>
                <DockPanel Margin="0,10,0,0">
                    <TextBlock DockPanel.Dock="Right" Width="58" TextAlignment="Right"
                               VerticalAlignment="Center" Foreground="#1D1D1F"
                               Text="{Binding HoldDelayLabel}"/>
                    <Slider Minimum="{Binding MinHoldDelayMs}" Maximum="{Binding MaxHoldDelayMs}"
                            Value="{Binding HoldDelayMs}" TickFrequency="50" IsSnapToTickEnabled="True"
                            VerticalAlignment="Center" Margin="0,0,12,0"/>
                </DockPanel>

                <Border Height="1" Background="#EEEEF0" Margin="0,14"/>

                <DockPanel>
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="Launch at startup" Style="{StaticResource RowTitle}"/>
                        <TextBlock Text="Start MacAccents automatically when you log in."
                                   Style="{StaticResource RowSubtitle}"/>
                    </StackPanel>
                    <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"
                              IsChecked="{Binding LaunchAtStartup}"/>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- UPDATES -->
        <TextBlock Text="UPDATES" Style="{StaticResource SectionHeader}"/>
        <Border Style="{StaticResource Card}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="Software update" Style="{StaticResource RowTitle}"/>
                    <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource RowSubtitle}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Download" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                            Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}"
                            Click="OnDownloadUpdate"/>
                    <Button Content="Check Now" Style="{StaticResource SecondaryButton}"
                            IsEnabled="{Binding CanCheck}" Click="OnCheckForUpdates"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Footer -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
            <Button Content="Cancel" Style="{StaticResource SecondaryButton}" MinWidth="88"
                    IsCancel="True" Click="OnCancel" Margin="0,0,8,0"/>
            <Button Content="Save" Style="{StaticResource PrimaryButton}" MinWidth="88"
                    IsDefault="True" Click="OnSave"/>
        </StackPanel>
    </StackPanel>
</Window>
