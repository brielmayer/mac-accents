<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>MacAccents</AssemblyName>
    <RootNamespace>MacAccents</RootNamespace>

    <!-- Default version for local builds; CI overrides via -p:Version=<tag>. -->
    <Version>1.0.0</Version>
    <Company>Brielmayer Consulting GmbH</Company>
    <Product>MacAccents</Product>
    <Copyright>© 2026 Brielmayer Consulting GmbH</Copyright>

    <!-- Treat .editorconfig code-style rules as build diagnostics
         (the `spotlessCheck` equivalent). Analyzer level stays at the SDK
         default — no cranked-up ruleset to maintain. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- WFO0003 wants DPI awareness set through the WinForms 'ApplicationHighDpiMode'
         property. That only takes effect via ApplicationConfiguration.Initialize(),
         which a WPF-first app never calls; WinForms is here for the tray icon alone.
         The manifest is the correct place for us. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embedded so the tray and windows can load it at runtime via pack URI. -->
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

</Project>
